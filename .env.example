# =============================================================================
# Radar Autônomo de Dermatologia — variáveis de ambiente
# Copie para ".env" (uso local) ou cadastre como GitHub Secrets
# (Settings → Secrets and variables → Actions). NUNCA faça commit do .env.
# =============================================================================

# ---- E-mail: destino -------------------------------------------------------
EMAIL_TO=seu-email@exemplo.com          # vários: separe por vírgula
EMAIL_FROM=seu-email@gmail.com          # remetente (no Gmail, igual ao SMTP_USER)

# ---- Opção A: SMTP (recomendado com Gmail) ----------------------------------
# Gmail: ative a verificação em 2 etapas e crie uma "Senha de app" em
# https://myaccount.google.com/apppasswords  (16 caracteres, sem espaços)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                           # 587 = STARTTLS · 465 = SSL
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=senha-de-app-aqui

# ---- Opção B: Resend (API HTTPS) — se definido, tem prioridade sobre o SMTP --
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM precisa ser de um domínio verificado no Resend
# (ou "onboarding@resend.dev" para testes enviando ao próprio e-mail da conta).

# ---- IA (opcional, recomendado) --------------------------------------------
# Sem esta chave o radar funciona em modo heurístico: classifica e filtra, mas
# os resumos ficam no idioma original e as ideias de Instagram são rascunhos.
ANTHROPIC_API_KEY=
# RADAR_MODEL=claude-opus-5             # padrão definido em config/radar.yaml
# RADAR_MAX_IA=40                       # máx. de itens analisados por dia (controle de custo)

# ---- PubMed (opcional) ------------------------------------------------------
# Chave gratuita aumenta o limite de requisições: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# ---- Comportamento ----------------------------------------------------------
# RADAR_ALERTAS=1                       # 0 desliga alertas extraordinários por e-mail
